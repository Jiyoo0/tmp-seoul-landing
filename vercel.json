{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/application",
      "destination": "/application.html"
    },
    {
      "source": "/submitted",
      "destination": "/submitted.html"
    }
  ]
}
